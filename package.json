    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "winston": "^3.17.0",
    "rate-limiter-flexible": "^5.0.3",
    "cidr-matcher": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14"
  },
  "engines": {
    "node": ">=18.0.0"
