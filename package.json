{
  "name": "src-hunter-mcp",
  "version": "1.0.0",
  "description": "Production-grade MCP server for automated SRC vulnerability hunting",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "sync-assets": "node dist/scripts/sync-assets.js",
    "check-tools": "node dist/scripts/check-tools.js"
  },
  "keywords": [
